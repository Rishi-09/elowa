PORT=4000
MONGO_URI=mongodb://localhost:27017/whisper
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TTL_SECONDS=600
REFRESH_TTL_DAYS=30
CORS_ORIGIN=*
LOG_LEVEL=info

# Rate limits (requests per window, per IP)
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_GENERAL_MAX=120
RATE_LIMIT_MEDIA_MAX=600
RATE_LIMIT_UPLOAD_MAX=60

# Media (Cloudinary). Leave empty to disable media endpoints.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=52428800

# GIF provider (Tenor v2). Leave empty to disable GIF search.
TENOR_API_KEY=
TENOR_CLIENT_KEY=whisper
